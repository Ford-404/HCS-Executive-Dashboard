# Procore: Developer Portal > your app > Developer Managed Service Account (DMSA)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=
PROCORE_ENV=production

# Email option A: SMTP (SendGrid, Mailgun, Google Workspace, M365 with SMTP AUTH)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Email option B: Microsoft Graph (set email.backend: graph in config.yaml)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
