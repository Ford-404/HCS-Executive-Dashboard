# Copy to .env and fill in. Never commit .env.
# Same Procore service account (DMSA) as the Safety Health Report. It also needs read access to
# Prime Contracts on every project (Company Admin > App Management > the app's permissions).
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=9593
# production | sandbox
PROCORE_ENV=production

# Only for email.method: graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Only for email.method: smtp
SMTP_USERNAME=
SMTP_PASSWORD=
